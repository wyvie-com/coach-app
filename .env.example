# Copy to .env and fill in. Never commit .env; the pre-commit hook and CI scan for secrets.
# Anthropic key for the review and grader models. ANTHROPIC_API_KEY is accepted as a fallback.
COACH_ANTHROPIC_API_KEY=
# Hevy key. Leave unset to use the platform proxy route, which injects the header itself.
HEVY_API_KEY=
